<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kernel tests, run from a Drupal site root with this module at
  web/modules/custom/damrs.

  Kept in the repository rather than generated by CI so that the local command
  and the CI command are the same file: a harness that only exists in a
  workflow is one nobody can reproduce when it fails.

  SQLite rather than a database service. These tests exercise the entity system,
  not database-specific behaviour, and a service container adds startup to a job
  that should stay cheap enough to keep.
-->
<phpunit bootstrap="web/core/tests/bootstrap.php" colors="false" cacheDirectory=".phpunit.cache" failOnWarning="true">
  <php>
    <env name="SIMPLETEST_DB" value="sqlite://localhost/sites/default/files/test.sqlite"/>
    <env name="SIMPLETEST_BASE_URL" value="http://localhost"/>
    <env name="BROWSERTEST_OUTPUT_DIRECTORY" value="/tmp"/>
  </php>
  <testsuites>
    <testsuite name="damrs kernel">
      <directory>web/modules/custom/damrs/modules/damrs_media/tests/src/Kernel</directory>
      <directory>web/modules/custom/damrs/modules/damrs_image_style/tests/src/Kernel</directory>
      <directory>web/modules/custom/damrs/modules/damrs_sync/tests/src/Kernel</directory>
      <directory>web/modules/custom/damrs/modules/damrs_editor/tests/src/Kernel</directory>
      <directory>web/modules/custom/damrs/modules/damrs_search_api/tests/src/Kernel</directory>
    </testsuite>
  </testsuites>
</phpunit>
